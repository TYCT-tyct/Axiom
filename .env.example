# The upstreams `just record` calls to record protocol samples (internal/protocol/README.md「录制样本」). Copy to .env,
# which git ignores; a variable set in the environment wins over the same one here. The names and base URLs are the
# ones the providers' SDKs use.

# Anthropic Messages: the host, such as https://api.anthropic.com
ANTHROPIC_BASE_URL=
ANTHROPIC_API_KEY=
# OpenAI Responses and Chat Completions: the URL ending in /v1, such as https://api.openai.com/v1
OPENAI_BASE_URL=
OPENAI_API_KEY=

# The node's outbound email (internal/platform/mail/README.md). Optional: with none of these set the node starts with
# email disabled, and setting any one of them requires the whole configuration or startup fails naming the variable.
# Every value stays empty here so a copied file leaves email disabled.
# The submission host name, such as smtp.example.com (no scheme, no port).
AXIOM_SMTP_HOST=
# The submission port; the default is 587. Port 465 speaks implicit TLS, every other port is upgraded with STARTTLS.
AXIOM_SMTP_PORT=
# The account and its password (a provider's app password works); set both or neither, the latter for a relay that
# admits this node by address. Neither is ever logged.
AXIOM_SMTP_USERNAME=
AXIOM_SMTP_PASSWORD=
# The sender: one address, optionally with a display name, such as Axiom <no-reply@example.com>.
AXIOM_SMTP_FROM=

# Optional web search (internal/websearch/README.md). The `web` plugin and the :online variant run one search through
# this SearXNG instance; with neither variable set every request that asks for web search keeps its documented refusal.
# The base URL of a SearXNG instance whose settings.yml enables the JSON format, such as https://search.example.com.
AXIOM_SEARCH_URL=
# A bearer token a reverse proxy in front of SearXNG checks; SearXNG itself does not authenticate. Optional, but a key
# without a URL is a startup error. Never logged.
AXIOM_SEARCH_KEY=

# Optional file parsing (internal/fileparse/README.md). The `file-parser` plugin's mistral-ocr and cloudflare-ai engines
# convert an inline document to text through this Docling serve instance before admission; with neither variable set
# every request that asks for one of them keeps its documented refusal. The native engine needs no backend.
# The base URL of a docling-serve instance, such as http://docling:5001.
AXIOM_FILE_PARSER_URL=
# The X-Api-Key docling-serve asks for when it runs with DOCLING_SERVE_API_KEY set. Optional, but a key without a URL
# is a startup error. Never logged.
AXIOM_FILE_PARSER_KEY=

# Optional automatic reference rates: set ecb on every node after upgrading the cluster to download ECB daily XML.
# Unset defaults to manual; existing manual currency pairs always remain fixed.
AXIOM_EXCHANGE_SOURCE=
# on only after every node runs a release that can read embeddings, rerank and legacy completions.
AXIOM_DIRECT_FORMATS=
# on only after every node runs a release that knows provider keys; off keeps accounts from creating them.
AXIOM_BYOK=

# The call log's local write-ahead spill (internal/observability/README.md「写入」). Unset or empty defaults to
# ./call-log. It must be persistent local storage: a record that has been served is fsynced here before its response
# ends and replayed after a crash. At the default capacity of 5000 the directory can reach about 320 MiB. A tmpfs or a
# directory removed on restart loses the records it holds. Every start fsyncs the directory and each directory above it,
# so the node must be able to open them for reading; a failure refuses startup. One node owns the directory: the
# recorder holds an exclusive lock on it and a second process refuses to start, because two writers from the same offset
# would overwrite each other. Point every node at its own directory, not at a volume shared between nodes.
AXIOM_CALL_LOG_DIR=

# Optional object storage (internal/platform/objectstore/README.md): the S3 bucket the program will write archives to.
# The backup job uses the same client with its own bucket and credentials (deploy/.env.example). With none of these set
# the node runs without object storage and nothing is lost: conversation bodies stay off either way
# (docs/domains/observability.md「保留与开关」). Setting any one of them requires the whole group, or startup fails
# naming the missing variable. The bucket and credentials belong to the deployment's owner.
# An S3-compatible endpoint such as https://s3.example.com; a base path is allowed when the gateway mounts the API
# under one. No trailing slash.
AXIOM_OBJECTSTORE_ENDPOINT=
AXIOM_OBJECTSTORE_BUCKET=
# The region in the credential scope; S3-compatible servers that ignore it still expect us-east-1.
AXIOM_OBJECTSTORE_REGION=
# The bucket's own credential pair. It is not the backup bucket's: those credentials are passed only to the ops job, so a
# compromised program never holds the credentials of the sets that restore the database.
AXIOM_OBJECTSTORE_ACCESS_KEY_ID=
AXIOM_OBJECTSTORE_SECRET_ACCESS_KEY=
# true (the default when unset) addresses the bucket in the path, as SeaweedFS, R2 and MinIO expect; false puts it in
# the host name, as AWS S3 does.
AXIOM_OBJECTSTORE_PATH_STYLE=
# Optional replica of the audit chain (docs/domains/operations.md「审计」): a bucket outside this deployment, with
# versioning and object lock on, and credentials that may write and read new objects but neither overwrite nor delete
# one. The same six variables as above, with the same rules; with none set the chain stays in this database only and
# the daily digest says so.
AXIOM_AUDIT_REPLICA_ENDPOINT=
AXIOM_AUDIT_REPLICA_BUCKET=
AXIOM_AUDIT_REPLICA_REGION=
AXIOM_AUDIT_REPLICA_ACCESS_KEY_ID=
AXIOM_AUDIT_REPLICA_SECRET_ACCESS_KEY=
AXIOM_AUDIT_REPLICA_PATH_STYLE=
