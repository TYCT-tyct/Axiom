# The passwords deploy/compose.yaml reads. `just up` writes them to deploy/.env, readable only by its owner, as random
# letters and digits: they go into URLs unencoded, so keep any you set yourself to those too.

# The superuser postgres: used only inside the postgres container, to create the database and run postgres/roles.sh
AXIOM_POSTGRES_PASSWORD=
# axiom_app, the only role the program logs in as while it runs (AXIOM_DATABASE_URL)
AXIOM_APP_PASSWORD=
# axiom_migrator, the migration administrator, which is not a superuser (AXIOM_MIGRATE_DATABASE_URL)
AXIOM_MIGRATOR_PASSWORD=
