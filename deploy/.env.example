# What deploy/compose.yaml reads from deploy/.env, and deploy/compose.edge.yaml for the edge. `just up` writes the four
# passwords, readable only by its owner, as random letters and digits: they go into URLs unencoded, so keep any you set
# yourself to those too. The rest belongs to the optional parts — the off-site backup and the edge — which `just up`
# writes none of.

# The superuser postgres: used only inside the postgres container, to create the database and run postgres/roles.sh
AXIOM_POSTGRES_PASSWORD=
# axiom_app, the only role the program logs in as while it runs (AXIOM_DATABASE_URL)
AXIOM_APP_PASSWORD=
# axiom_migrator, the migration administrator, which is not a superuser (AXIOM_MIGRATE_DATABASE_URL)
AXIOM_MIGRATOR_PASSWORD=
# axiom_retention, the call-log retention job's own login. Optional: empty leaves the retention job off.
AXIOM_RETENTION_PASSWORD=
# Its connection string (AXIOM_RETENTION_DATABASE_URL). `just up` writes it; keep pool_max_conns=2, the job is serial.
AXIOM_RETENTION_DATABASE_URL=

# true or false; anything else, an empty value included, stops the start, and only leaving it unset means true. The keys
# service makes the key ring (master, hash, identity) only as a whole, into an empty volume, and only when this is true;
# a volume with part of the ring stops the start either way. Production sets it false once the first start has made the
# ring, and multi-node deployments always (every node uses the same files: a shared protected volume, or the same files
# copied to each node), so an empty volume is refused instead of getting a second, divergent ring. Local `just up`
# leaves it true.
AXIOM_KEYRING_GENERATE=true

# This node's roles, comma-separated: core, ingress, ops. The single-machine deployment is core (the default). An ingress
# forwards the public listener to AXIOM_CORE_URL over mutual TLS and holds no database or key ring; an ops node serves
# only its probes. A node that is given variables its role does not use refuses to start.
AXIOM_NODE_ROLES=core
# The program's admin source restriction (comma-separated addresses or CIDRs). The edge deployment defaults to this
# machine alone. The single-machine compose publishes the admin port on the host's loopback and allows every source in
# the container, because Docker rewrites a published port's peer address; the socket bind is the boundary there.
AXIOM_ADMIN_SOURCES=
# Node-to-node mutual TLS. A core accepts peers on AXIOM_NODE_ADDR; an ingress forwards to AXIOM_CORE_URL (https). Both
# read node.crt, node.key (mode 0600) and ca.crt from AXIOM_NODE_TLS_DIR, signed by the deployment's internal CA. A core
# defaults the directory to the master key's; issuance, registration and rotation are the deployment's for now. A core
# also needs each ingress's address in AXIOM_TRUSTED_PROXIES for the client's address and scheme to survive the hop.
AXIOM_NODE_ADDR=
AXIOM_CORE_URL=
AXIOM_NODE_TLS_DIR=

# The off-site backup (profile ops; docs/ops/backup-restore.md「备份」). `just up` writes none of these. A deployment that
# backs up needs the bucket, its credentials and the two recipients; the rest has the defaults below.

# The bucket the sets are written into, and the prefix under it.
AXIOM_BACKUP_BUCKET=
AXIOM_BACKUP_PREFIX=axiom
# Any S3-compatible endpoint (MinIO, R2, Backblaze, OSS): leave the endpoint empty for AWS S3 itself and set the region.
AXIOM_BACKUP_S3_ENDPOINT=
AXIOM_BACKUP_S3_ACCESS_KEY_ID=
AXIOM_BACKUP_S3_SECRET_ACCESS_KEY=
AXIOM_BACKUP_S3_REGION=us-east-1
AXIOM_BACKUP_S3_FORCE_PATH_STYLE=true

# WAL and base backups (docs/ops/backup-restore.md「WAL 连续归档与时间点恢复」): the WAL bucket, which follows
# AXIOM_BACKUP_BUCKET unless overridden below, also turns on continuous archiving in the database container. That needs
# the passphrase below; a deployment that starts archiving must set it in the same change, or the database refuses to
# start. One that does not back up leaves the WAL bucket empty and archiving off. Keep a copy of the passphrase off this
# machine with the age identities: without it the archive cannot be read, while the logical sets above still can.
AXIOM_BACKUP_CIPHER_PASS=
# The bucket the database archives WAL to. Leave it unset to follow AXIOM_BACKUP_BUCKET; set it to use a separate bucket,
# or leave an empty AXIOM_BACKUP_WAL_BUCKET= line to turn archiving off while keeping the logical sets. The restore script
# writes that empty line for a restored cluster, because its new system identifier cannot reuse the old stanza.
# AXIOM_BACKUP_WAL_BUCKET=
# The archive's key prefix; empty means <AXIOM_BACKUP_PREFIX>-pgbackrest. Keep it outside AXIOM_BACKUP_PREFIX (and its
# subpaths): the logical sets' retention lists and deletes its own prefix. A cluster restored from a logical set has a new
# system identifier and needs a new prefix, not the old stanza.
AXIOM_BACKUP_WAL_PREFIX=
# How pgBackRest addresses the bucket: path for SeaweedFS, R2, MinIO and Backblaze; host for AWS S3. Separate from
# AXIOM_BACKUP_S3_FORCE_PATH_STYLE above because it is a different client.
AXIOM_BACKUP_S3_URI_STYLE=path

# age recipients (age1...): public keys only. The private identities are files that stay off this machine and are needed
# to restore, never to back up. The database's sets and this file go to the first, the key ring to the second, and the
# two must differ (the backup refuses to run otherwise).
AXIOM_BACKUP_DB_RECIPIENT=
AXIOM_BACKUP_SECRETS_RECIPIENT=

# The program's object store (internal/platform/objectstore/README.md), passed to the axiom service. Optional: with none
# of these set the node runs without it. The bucket and credentials are the owner's, and they are deliberately not the
# backup bucket's above: the backup credentials go only to the ops jobs and the database container, so a compromised
# program cannot reach the sets that restore the database. The node only checks this configuration at startup today;
# archives and a conversation-body switch are later features. The backup job uses the same client, configured with the
# backup's own bucket above (docs/ops/backup-restore.md).
AXIOM_OBJECTSTORE_ENDPOINT=
AXIOM_OBJECTSTORE_BUCKET=
AXIOM_OBJECTSTORE_REGION=
AXIOM_OBJECTSTORE_ACCESS_KEY_ID=
AXIOM_OBJECTSTORE_SECRET_ACCESS_KEY=
AXIOM_OBJECTSTORE_PATH_STYLE=
# The audit chain's replica, passed to the axiom service (docs/domains/operations.md「审计」). Optional: with none set
# the chain stays in the database only. A bucket outside this deployment with versioning and object lock, and
# credentials that write and read objects and list the bucket, but can neither overwrite nor delete one; not
# the buckets above.
AXIOM_AUDIT_REPLICA_ENDPOINT=
AXIOM_AUDIT_REPLICA_BUCKET=
AXIOM_AUDIT_REPLICA_REGION=
AXIOM_AUDIT_REPLICA_ACCESS_KEY_ID=
AXIOM_AUDIT_REPLICA_SECRET_ACCESS_KEY=
AXIOM_AUDIT_REPLICA_PATH_STYLE=

# Retention: the newest N sets, and nothing older than D days. Both limits apply, both are at least 1, and the set of the
# run that prunes is never one of them. There is no value that means "keep forever": a number nobody reaches is how a
# deployment says that, because 0 would delete everything the run had just written.
AXIOM_BACKUP_KEEP_SETS=30
AXIOM_BACKUP_KEEP_DAYS=30
# The whole upload or download of one file. The default covers a large dump over a slow link; it is finite so a stuck
# transfer still ends, and the CLI validates the duration. The connection has its own shorter timeouts.
AXIOM_BACKUP_TRANSFER_TIMEOUT=12h

# The production edge (deploy/compose.edge.yaml; docs/ops/backup-restore.md「生产入口」). All three hostnames need DNS
# pointing at this machine and ports 80 and 443 reachable, or Caddy cannot get its certificates.

# The hostnames the three surfaces answer on, and they must be three: a domain in accounts.site_domains belongs to one
# surface, so the console and the model API cannot share a name. Register them with the site (`axiom site init --console
# HOST --api HOST --admin HOST`): the program resolves the site, and which surface serves there, by the Host header the
# edge passes through unchanged. Anything else under any of the three names is refused by the program itself.
AXIOM_EDGE_CONSOLE_HOST=
AXIOM_EDGE_API_HOST=
AXIOM_EDGE_ADMIN_HOST=
# Who may reach the console: space-separated addresses or CIDRs, read by Caddy. It is everyone by default, because the
# console is the users' dashboard. The admin app's sources are the program's AXIOM_ADMIN_SOURCES above.
# An existing edge deployment that set AXIOM_EDGE_ADMIN_ALLOW_CIDRS must move the same list to AXIOM_ADMIN_SOURCES,
# changing spaces to commas (for example "10.0.0.0/8 192.0.2.0/24" becomes "10.0.0.0/8,192.0.2.0/24"); the old variable
# is no longer read; leaving AXIOM_ADMIN_SOURCES unset keeps the edge's loopback-only default.
AXIOM_EDGE_CONSOLE_ALLOW_CIDRS=
# `acme` (the default) is public certificates over the ACME HTTP challenge; `internal` is Caddy's own CA, whose root a
# client then has to trust, for a deployment with no public DNS.
AXIOM_EDGE_TLS_ISSUER=
# Only on a machine where 172.28.0.0/24 is already taken: the edge's network, and the address in it that the program is
# told to trust as its proxy.
AXIOM_EDGE_SUBNET=
AXIOM_EDGE_PROXY_ADDRESS=
# Only where 80 or 443 is taken, or where another stack on this machine must not be reached through a published port: the
# ports the edge publishes. Left commented out they are 80 and 443; an empty value (not a commented-out line) publishes a
# port the kernel picks, which only the rehearsal wants.
# AXIOM_EDGE_HTTP_PORT=80
# AXIOM_EDGE_HTTPS_PORT=443

# Optional endpoint breaker mode: observe (default) or enforce. See docs/domains/quality.md.
AXIOM_HEALTH_MODE=

# Optional: on permits the response cache to store reply content, off (default) keeps it disabled. The platform's
# content-retention decision must be made first; see docs/domains/gateway.md「响应缓存」.
AXIOM_RESPONSE_CACHE_CONTENT=

# Optional reference-rate source: manual (default) or ecb. Set consistently on every upgraded node.
# Before disabling ECB, write each retained pair as manual and close any stale alert (billing.md「汇率」).
AXIOM_EXCHANGE_SOURCE=

# The rest of what a core reads, all optional, passed to the axiom service as written here. Empty keeps the program's
# default (internal/platform/README.md lists every variable). The deployment refuses an AXIOM_* setting in this file
# that no service reads (scripts/ops/up.sh), so a misspelled name or a variable this deployment fixes itself (the listen
# addresses, the key and volume paths, AXIOM_SHUTDOWN_TIMEOUT) stops it instead of being silently dropped.

# on (default) or off: whether the health loop checks that endpoints are the models they claim (docs/domains/quality.md).
AXIOM_MODEL_VERIFICATION=
# on or off (default): the gates on writing the direct formats and on creating provider keys. Turn one on only when
# every node runs a build that knows it (docs/domains/gateway.md, docs/domains/accounts.md).
AXIOM_DIRECT_FORMATS=
AXIOM_BYOK=
# Proxies whose X-Forwarded-For the program trusts (comma-separated addresses or CIDRs); none by default. With the edge
# (deploy/compose.edge.yaml) the edge fixes it to its own address, and setting it here is refused.
AXIOM_TRUSTED_PROXIES=
# Tuning, with the program's defaults when empty: the startup bound, the connections kept for completions, and the
# argon2id computations at once and how long a sign-in waits for one.
AXIOM_STARTUP_TIMEOUT=
AXIOM_DB_COMPLETION_RESERVE=
AXIOM_HASH_CONCURRENCY=
AXIOM_HASH_WAIT=
# The number of core nodes (default 1; above 1 needs the shared cache, which this file runs) and this node's name
# (default the container's host name) (internal/platform/kv/README.md「配置与启动」).
AXIOM_CORE_NODES=
AXIOM_NODE_ID=
# The operations listener, off while the address is empty (docs/security.md「运营调用面」): mutual TLS with the node
# certificates, and AXIOM_OPERATIONS_SOURCES is required when the address is not loopback. No port is published for it.
AXIOM_OPERATIONS_ADDR=
AXIOM_OPERATIONS_SOURCES=
# Email (internal/platform/mail/README.md): none set leaves email off; a saved configuration in the admin wins.
AXIOM_SMTP_HOST=
AXIOM_SMTP_PORT=
AXIOM_SMTP_USERNAME=
AXIOM_SMTP_PASSWORD=
AXIOM_SMTP_FROM=
# The web search and file parser backends (internal/websearch/README.md, internal/fileparse/README.md): off while the
# URL is empty; a saved configuration in the admin wins.
AXIOM_SEARCH_URL=
AXIOM_SEARCH_KEY=
AXIOM_FILE_PARSER_URL=
AXIOM_FILE_PARSER_KEY=
