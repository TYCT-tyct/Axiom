{
  "name": "axiom-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./{site,console,admin}\" dev",
    "build": "pnpm --recursive build",
    "typecheck": "tsc && pnpm --recursive typecheck",
    "lint": "biome ci",
    "limits": "node scripts/limits.ts",
    "unused": "knip",
    "duplicates": "jscpd",
    "test": "vitest run",
    "budget": "node scripts/budget.ts",
    "embed": "node scripts/embed.ts",
    "e2e": "playwright test",
    "journey": "playwright test -c playwright.journey.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "web-vitals": "6.2.3"
  }
}
