{
  "$schema": "./node_modules/knip/schema.json",
  // The packages are the apps' own, not published: an export no app imports is unused, entry files included.
  "includeEntryExports": true,
  "workspaces": {
    // vite.shared.ts reads theme.js as text and serves it, which knip cannot follow.
    ".": {
      "entry": ["theme.js"],
      // journey/node.ts starts the Go test binary of cmd/axiom/journey_test.go.
      "playwright": {
        "config": [
          "playwright.config.ts",
          "playwright.boards.config.ts",
          "playwright.journey.config.ts",
          "playwright.vitals.config.ts"
        ]
      },
      "ignoreBinaries": ["go"],
      // e2e/vitals.spec.ts reads the library's IIFE file by path to inject it into pages; no import names it.
      "ignoreDependencies": ["web-vitals"]
    }
  },
  // These requested standalone design engines are generated assets outside the current boards' import graphs.
  "ignore": ["**/*.gen.ts", "packages/boards/src/engines/eggs.js", "packages/boards/src/engines/routes.js"]
}
